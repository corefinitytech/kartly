# App
APP_URL=http://localhost:3000

# Auth (Better Auth). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=base64-32-byte-secret

# Database (PostgreSQL - Neon or Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/kartly

# PII field encryption: 32 bytes, base64 encoded (AES-256-GCM). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENC_KEY=base64-encoded-32-byte-key

# Salt for hashing IP addresses in the audit log (never store raw IPs)
IP_HASH_SALT=random-string

# Secret required in the Authorization header of /api/cron/* routes
CRON_SECRET=random-string

# Stripe (test mode only)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend (transactional email)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Kartly <no-reply@example.com>"

# Upstash Redis (rate limiting and cache)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
